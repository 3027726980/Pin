# =============================================================================
# Pin 部署环境变量模板
# 用法：复制为 .env 后填写（.env 已被 Git 忽略，绝不提交）
# =============================================================================

# ── 数据库（db 服务初始化 + backend 连接串自动拼接）─────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=pin
POSTGRES_PASSWORD=change-me-strong-password

# ── 应用安全 ────────────────────────────────────────────────────────────────
# JWT 密钥生成：openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── 镜像与入口 ──────────────────────────────────────────────────────────────
# GPU 服务器：改为 pin-backend:gpu（并在 override 中将 backend.build.target 设为 runtime-gpu）
BACKEND_IMAGE=pin-backend:cpu
FRONTEND_IMAGE=pin-frontend:latest
FRONTEND_PORT=80
