# 只在开发模式中被载入
VITE_PORT = 8001

# 网站根目录
VITE_PUBLIC_PATH = /

# 是否开启 mock
VITE_USE_MOCK = false

# 是否开启控制台打印 mock 请求信息
VITE_LOGGER_MOCK = false

# 是否删除console
VITE_DROP_CONSOLE = true

# 跨域代理：/api 转发到 Pin FastAPI 后端
VITE_PROXY = [["/api","http://localhost:8000"]]

# API 接口地址（开发环境留空，走 vite proxy）
VITE_GLOB_API_URL =

# 接口前缀
VITE_GLOB_API_URL_PREFIX = /api

# 文件上传地址
VITE_GLOB_UPLOAD_URL=

# 文件前缀地址
VITE_GLOB_FILE_URL=
